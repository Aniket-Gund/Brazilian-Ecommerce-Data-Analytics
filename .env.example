# ==============================================================================
# Brazilian E-Commerce (Olist) Analytics Platform - Environment Configuration
# TEMPLATE FILE: Copy this file to '.env' and populate with your credentials.
# DO NOT COMMIT LIVE PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud PostgreSQL (Transactional Fact Layer)
# Connected via PgBouncer / Supavisor IPv4 Session Pooler on port 5432.
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres
# ------------------------------------------------------------------------------
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@aws-0-eu-north-1.pooler.supabase.com:5432/postgres

# Granular Connection Parameters (if connecting via individual variables)
SUPABASE_USER=postgres.your-project-ref
SUPABASE_PASSWORD=your-database-password
SUPABASE_HOST=aws-0-eu-north-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_PROJECT_REF=your-project-ref

# ------------------------------------------------------------------------------
# 2. Google Cloud BigQuery Sandbox (Analytical Dimension Layer)
# Columnar storage for dim_customers, dim_products, dim_sellers, dim_date.
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=olist_ecommerce
GOOGLE_APPLICATION_CREDENTIALS=docs/gcp_service_account.json

# ------------------------------------------------------------------------------
# 3. Google Sheets REST API (Governance & KPI Parameter Layer)
# Disconnected parameter table (kpi_targets) & category translations.
# ------------------------------------------------------------------------------
GSHEET_CREDENTIALS_JSON=docs/gsheets_service_account.json
GSHEET_NAME=Olist Reference Data
